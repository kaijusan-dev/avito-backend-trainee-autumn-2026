{
  "name": "avito-backend-trainee-autumn-2026",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:platform": "chcp 65001 && tsx watch platform-api/src/server.ts",
    "dev:restaurant": "chcp 65001 && tsx watch restaurant-api/src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:platform": "vitest run platform-api",
    "test:restaurant": "vitest run restaurant-api",
    "build": "tsc",
    "start:platform": "node platform-api/build/platform-api/src/server.js",
    "start:restaurant": "node restaurant-api/build/restaurant-api/src/server.js",
    "db:generate": "prisma generate --config platform-api/prisma.config.ts && prisma generate --config restaurant-api/prisma.config.ts",
    "db:migrate:platform": "prisma migrate dev --config platform-api/prisma.config.ts",
    "db:migrate:restaurant": "prisma migrate dev --config restaurant-api/prisma.config.ts",
    "db:migrate:test:platform": "cross-env PLATFORM_DATABASE_URL=postgresql://postgres:postgres@localhost:2222/platform_db_test?schema=public prisma migrate deploy --config platform-api/prisma.config.ts",
    "db:migrate:test:restaurant": "cross-env RESTAURANT_DATABASE_URL=postgresql://postgres:postgres@localhost:3333/restaurant_db_test?schema=public prisma migrate deploy --config restaurant-api/prisma.config.ts",
    "db:migrate:test": "npm run db:migrate:test:platform && npm run db:migrate:test:restaurant"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaijusan-dev/avito-backend-trainee-autumn-2026.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/kaijusan-dev/avito-backend-trainee-autumn-2026/issues"
  },
  "homepage": "https://github.com/kaijusan-dev/avito-backend-trainee-autumn-2026#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.1",
    "@scalar/express-api-reference": "^0.10.19",
    "@types/express": "^4.17.21",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "pg": "^8.22.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
