# parameters for postgres 
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
PLATFORM_DB_NAME=platform_db
RESTAURANT_DB_NAME=restaurant_db

PLATFORM_API_PORT=3000
RESTAURANT_API_PORT=3001

PLATFORM_DB_PORT=2222
RESTAURANT_DB_PORT=3333
# databases url
PLATFORM_DATABASE_URL=postgresql://user:password@localhost:2222/platform_db?schema=public
RESTAURANT_DATABASE_URL=postgresql://user:password@localhost:3333/restaurant_db?schema=public
# service url
RESTAURANT_SERVICE_URL=http://localhost:3001
# base parameters
NODE_ENV=development